<!--
  Pas d'attribut `package` ici : depuis AGP 8 l'identité du module vient du
  `namespace` déclaré dans android/build.gradle.kts, et le déclarer deux fois
  est au mieux redondant. Les noms de classe relatifs (.RadioMediaService)
  continuent de se résoudre contre ce namespace à la fusion.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Accès réseau -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Foreground service — requis API 9+, indispensable pour la lecture en arrière-plan -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Foreground service type "mediaPlayback" — requis depuis API 29 (Android 10).
         Sur API 24-28, cette permission est inconnue mais installée sans erreur.
         tools:ignore="ProtectedPermissions" supprime l'avertissement lint. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
        tools:ignore="ProtectedPermissions" />

    <!-- Notifications runtime — API 33+ (Android 13).
         Le plugin ne la demande JAMAIS et n'en a pas besoin : sa notification
         passe par une MediaSession, et Android exempte explicitement ces
         notifications de POST_NOTIFICATIONS. Elle s'affiche donc sans qu'aucune
         autorisation n'ait été accordée.
         La déclaration est conservée pour l'application hôte : une déclaration
         n'a aucun effet tant que personne ne demande, et elle évite à un hôte
         qui poste ses propres notifications d'avoir à l'ajouter. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Visibilité du paquet qui héberge le panneau d'égaliseur du
         constructeur. Depuis Android 11 (API 30), resolveActivity et
         queryIntentActivities ne rendent QUE les activités que l'application
         a le droit de voir : sans cette déclaration, le panneau de Samsung,
         Xiaomi ou autre est invisible, resolveActivity rend null, et le plugin
         conclut à tort qu'il n'y a pas d'égaliseur constructeur — puis attache
         le sien. L'activité existe pourtant bel et bien.
         Ce bloc est fusionné dans le manifeste de l'application hôte. -->
    <queries>
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
    </queries>

    <application
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- MediaSessionService — maintient la lecture en arrière-plan.
             android:foregroundServiceType="mediaPlayback" :
               - Requis depuis API 29 pour startForeground() sur les services audio.
               - Sur API 24-28 : attribut ignoré par Android, le service fonctionne normalement.
             android:exported="true" : requis pour que le système puisse lier la session
               (écran de verrouillage, Bluetooth, Android Auto). -->
        <service
            android:name=".RadioMediaService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

    </application>

</manifest>