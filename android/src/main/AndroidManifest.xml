<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.dev.gcimia.radio_service">

    <!-- Accès réseau -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Foreground service — requis API 9+, indispensable pour la lecture en arrière-plan -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Foreground service type "mediaPlayback" — requis depuis API 29 (Android 10).
         Sur API 24-28, cette permission est inconnue mais installée sans erreur.
         tools:ignore="ProtectedPermissions" supprime l'avertissement lint. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
        tools:ignore="ProtectedPermissions" />

    <!-- Notifications runtime — API 33+ (Android 13).
         Le plugin ne la demande JAMAIS et n'en a pas besoin : sa notification
         passe par une MediaSession, et Android exempte explicitement ces
         notifications de POST_NOTIFICATIONS. Elle s'affiche donc sans qu'aucune
         autorisation n'ait été accordée.
         La déclaration est conservée pour l'application hôte : une déclaration
         n'a aucun effet tant que personne ne demande, et elle évite à un hôte
         qui poste ses propres notifications d'avoir à l'ajouter. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- MediaSessionService — maintient la lecture en arrière-plan.
             android:foregroundServiceType="mediaPlayback" :
               - Requis depuis API 29 pour startForeground() sur les services audio.
               - Sur API 24-28 : attribut ignoré par Android, le service fonctionne normalement.
             android:exported="true" : requis pour que le système puisse lier la session
               (écran de verrouillage, Bluetooth, Android Auto). -->
        <service
            android:name=".RadioMediaService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

    </application>

</manifest>